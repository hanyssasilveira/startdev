algoritmo "alunos"
var
   N1, N2, media: Real

inicio
   EscrevaL("Escola")
   Escreva("Primeira Nota: ")
   Leia (N1)
   Escreva("Segunda Nota: ")
   Leia (N2)
   media <- (N1 + N2) / 2
   EscrevaL ("Média: ", media:4:2)

   Se media >= 7.0 entao
      Escreva("Aluno Aprovado")
   senao
      Se (media >= 5.0) e (media < 7.0) entao
         Escreva("Aluno em Recuperação")
      senao
         Escreva ("Aluno Reprovado")
      FimSe
   FimSe


fimalgoritmo
